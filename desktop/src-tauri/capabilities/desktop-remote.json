{
  "identifier": "desktop-remote",
  "description": "IPC access for the local gateway origin served by the sidecar",
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*/**", "http://localhost:*/**"]
  },
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "allow-get-session",
    "allow-backend-status",
    "allow-restart-backend",
    "allow-open-data-dir",
    "allow-quit-app"
  ]
}
